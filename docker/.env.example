# Nexus RMM - Production Environment Variables
# Copy this file to .env and fill in the values

# Database
POSTGRES_PASSWORD=your-secure-postgres-password-here

# Redis
REDIS_PASSWORD=your-secure-redis-password-here

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET=your-256-bit-jwt-secret-here

# Domain
DOMAIN=rmm.mezfashion.pro

# Email (for Let's Encrypt)
LETSENCRYPT_EMAIL=admin@mezfashion.pro

# Optional: External license server
LICENSE_SERVER_URL=

# Optional: S3-compatible storage for recordings/backups
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=